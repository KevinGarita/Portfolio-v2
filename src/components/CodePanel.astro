---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<div
	aria-hidden="true"
	class="relative h-[clamp(340px,34vw,430px)] overflow-hidden rounded-xl border border-white/8 bg-linear-to-b from-white/[0.025] to-white/[0.005]"
>
	<pre
		data-code-rain
		class="mask-code absolute inset-x-0 top-11.75 bottom-0 m-0 overflow-hidden whitespace-pre px-4.5 py-3.5 font-mono text-mono leading-normal text-code select-none"></pre>
	<div
		class="absolute inset-x-0 top-0 flex items-center justify-between border-b border-white/6 px-4.5 py-3.5 font-mono text-tiny uppercase tracking-caps text-subtle"
	>
		<span class="flex items-center gap-2">
			<span class="block size-1.5 rounded-full bg-accent"></span>live / build
		</span>
		<span>{site.initials} / {year}</span>
	</div>
</div>

<script>
	// Decorative "live build" grid of glyphs that keep flickering. Sized to fit
	// the panel; static when the user prefers reduced motion.
	const CHARS =
		"01<>{}[]()/\\|=+-*&^%$#@!?;:.,_~ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
	const SPEED = 90;
	const rnd = () => CHARS[(Math.random() * CHARS.length) | 0];
	const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

	for (const el of document.querySelectorAll<HTMLElement>("[data-code-rain]")) {
		let cells: HTMLSpanElement[] = [];
		let fitKey = "";
		let timer = 0;
		let visible = true;

		const fill = () => {
			const key = `${el.clientWidth}x${el.clientHeight}`;
			if (key === fitKey) return;
			fitKey = key;
			const cs = getComputedStyle(el);
			const probe = document.createElement("span");
			probe.textContent = "MMMMMMMMMM";
			probe.style.cssText =
				"position:absolute;visibility:hidden;white-space:pre;font:inherit";
			el.appendChild(probe);
			const cw = probe.getBoundingClientRect().width / 10 || 7.8;
			probe.remove();
			const lh = Number.parseFloat(cs.lineHeight) || 19.5;
			const w =
				el.clientWidth -
				Number.parseFloat(cs.paddingLeft) -
				Number.parseFloat(cs.paddingRight);
			const h =
				el.clientHeight -
				Number.parseFloat(cs.paddingTop) -
				Number.parseFloat(cs.paddingBottom);
			const cols = Math.max(10, Math.floor(w / cw));
			const rows = Math.max(4, Math.floor(h / lh));
			const frag = document.createDocumentFragment();
			for (let r = 0; r < rows; r++) {
				for (let c = 0; c < cols; c++) {
					const span = document.createElement("span");
					span.textContent = Math.random() < 0.08 ? " " : rnd();
					frag.appendChild(span);
				}
				frag.appendChild(document.createTextNode("\n"));
			}
			el.replaceChildren(frag);
			cells = [...el.querySelectorAll("span")];
		};

		const tick = () => {
			const n = Math.max(5, Math.round(cells.length * 0.028));
			for (let i = 0; i < n; i++) {
				const cell = cells[(Math.random() * cells.length) | 0];
				cell.textContent = Math.random() < 0.07 ? " " : rnd();
				const roll = Math.random();
				cell.className =
					roll > 0.986 ? "code-hot" : roll > 0.95 ? "text-dim" : "";
			}
		};

		const sync = () => {
			clearInterval(timer);
			timer = 0;
			if (visible && !reduce.matches && !document.hidden) {
				timer = window.setInterval(tick, SPEED);
			}
		};

		fill();
		document.fonts?.ready.then(() => {
			fitKey = "";
			fill();
		});
		let resizeTimer = 0;
		window.addEventListener("resize", () => {
			clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(fill, 120);
		});
		new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			sync();
		}).observe(el);
		document.addEventListener("visibilitychange", sync);
		reduce.addEventListener("change", sync);
	}
</script>
