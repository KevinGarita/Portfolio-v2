---
import { render } from "astro:content";
import { getEducation, yearRange } from "../data/queries";
import LogoMark from "./ui/LogoMark.astro";
import Reveal from "./ui/Reveal.astro";
import SectionHeading from "./ui/SectionHeading.astro";

const entries = await Promise.all(
	(await getEducation()).map(async (entry) => ({
		...entry.data,
		Content: (await render(entry)).Content,
	})),
);
---

<section id="education" class="scroll-mt-nav px-gutter pb-section">
	<div class="mx-auto max-w-page">
		<SectionHeading
			eyebrow="03 — Education & Certificates"
			title="Education & credentials"
			class="mb-10"
		/>
		<div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-5">
			{
				entries.map(({ Content, ...e }, i) => (
					<Reveal delay={(i % 3) * 80}>
						<article class="h-full rounded-card border border-white/10 bg-linear-to-b from-white/[0.035] to-white/[0.012] p-6.5 transition-[translate,border-color] duration-300 ease-out-soft hover:-translate-y-1 hover:border-accent/42 hover:from-accent/7">
							<LogoMark src={e.logo} alt={`${e.title} logo`} class="mb-5.5 size-14" />
							<p class="mb-2.5 font-mono text-label tracking-[0.09em] text-accent">
								{yearRange(e.startDate, e.endDate)}
							</p>
							<h3 class="mb-2 text-title font-medium text-ink">{e.subtitle}</h3>
							<p class="mb-3.5 text-btn text-subtle">{e.title}</p>
							<div class="prose-entry text-btn leading-[1.6]">
								<Content />
							</div>
						</article>
					</Reveal>
				))
			}
		</div>
	</div>
</section>
