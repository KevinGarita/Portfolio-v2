---
import { skillGroups } from "../data/skills";
import Reveal from "./ui/Reveal.astro";
import SectionHeading from "./ui/SectionHeading.astro";
---

<section id="skills" class="scroll-mt-nav px-gutter pb-section">
	<div class="mx-auto max-w-page">
		<SectionHeading
			eyebrow="02 — Skills"
			title="Toolbox"
			tone="subtle"
			class="mb-9"
		>
			<p
				class="font-mono text-label uppercase tracking-caps text-subtle"
			>
				Index — {String(skillGroups.length).padStart(2, "0")} categories
			</p>
		</SectionHeading>

		<!-- 4 → 2 → 1 columns (never 3 + 1), switching where 240px boxes stop fitting -->
		<div class="@container">
			<div
				class="grid grid-cols-1 gap-px bg-white/9 p-px @min-[484px]:grid-cols-2 @min-[966px]:grid-cols-4"
			>
			{
				skillGroups.map((group) => (
					<Reveal class="bg-bg pb-3.5">
						<div class="border-b border-white/9 px-6 pt-6 pb-4.5">
							<h3 class="mb-1 font-serif text-group font-normal text-ink">
								{group.name}
							</h3>
							<p class="font-mono text-tiny uppercase tracking-caps text-subtle">
								{group.sub}
							</p>
						</div>
						<ul>
							{group.items.map((item, i) => (
								<li class="flex items-center justify-between gap-3 px-6 py-2.5 font-mono text-mono text-ink-soft transition-[color,background-color,padding] duration-200 ease-out-soft hover:bg-accent/6 hover:pl-7.5 hover:text-accent">
									<span>{item}</span>
									<span class="text-tiny text-subtle">
										{String(i + 1).padStart(2, "0")}
									</span>
								</li>
							))}
						</ul>
					</Reveal>
				))
			}
			</div>
		</div>
	</div>
</section>
